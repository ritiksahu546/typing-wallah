{
  "entities": {
    "AdminRole": {
      "title": "AdminRole",
      "description": "Server-managed administrator role registry (read-only to clients)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "grantedAt": { "type": "string" },
        "revoked": { "type": "boolean" }
      },
      "required": ["uid"]
    },
    "User": {
      "title": "User",
      "description": "Registered candidate profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "targetExam": { "type": "string" },
        "referralCode": { "type": "string" },
        "joinedDate": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "UserResult": {
      "title": "UserResult",
      "description": "Immutable candidate typing test attempt result",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "testId": { "type": "string" },
        "username": { "type": "string" },
        "userEmail": { "type": "string" },
        "examId": { "type": "string" },
        "examName": { "type": "string" },
        "language": { "type": "string" },
        "keyboardLayout": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "timestamp": { "type": "number" },
        "metrics": { "type": "object" }
      },
      "required": ["userId", "metrics", "timestamp"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "High score benchmark entry on public leaderboard backed by an immutable UserResult",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "testId": { "type": "string" },
        "username": { "type": "string" },
        "photoURL": { "type": "string" },
        "exam": { "type": "string" },
        "examId": { "type": "string" },
        "language": { "type": "string" },
        "netWpm": { "type": "number" },
        "grossWpm": { "type": "number" },
        "accuracy": { "type": "number" },
        "timestamp": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["userId", "testId", "netWpm", "grossWpm", "accuracy"]
    },
    "CourseProgress": {
      "title": "CourseProgress",
      "description": "Student touch typing course progress and locked/unlocked state",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "currentLessonNumber": { "type": "number" },
        "highestUnlockedLessonNumber": { "type": "number" },
        "completedLessonIds": { "type": "array", "items": { "type": "string" } },
        "bestWpm": { "type": "number" },
        "avgWpm": { "type": "number" },
        "avgAccuracy": { "type": "number" },
        "totalAttempts": { "type": "number" },
        "passedAttempts": { "type": "number" },
        "currentStreak": { "type": "number" },
        "lastActiveDate": { "type": "string" },
        "lastUpdated": { "type": "number" }
      },
      "required": ["userId", "highestUnlockedLessonNumber"]
    },
    "LessonAttempt": {
      "title": "LessonAttempt",
      "description": "Immutable student lesson test attempt history record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lessonId": { "type": "string" },
        "lessonNumber": { "type": "number" },
        "lessonName": { "type": "string" },
        "netWpm": { "type": "number" },
        "grossWpm": { "type": "number" },
        "accuracy": { "type": "number" },
        "errors": { "type": "number" },
        "backspaces": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "passed": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "lessonId", "passed", "timestamp"]
    },
    "CourseLesson": {
      "title": "CourseLesson",
      "description": "Admin configurable touch typing lesson content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lessonNumber": { "type": "number" },
        "level": { "type": "number" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "targetWpm": { "type": "number" },
        "minAccuracy": { "type": "number" },
        "isPro": { "type": "boolean" },
        "status": { "type": "string" }
      },
      "required": ["lessonNumber", "name", "level"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "User subscription state managed strictly by server/admin",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string" },
        "startDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["uid", "plan", "status"]
    },
    "ReferralCode": {
      "title": "ReferralCode",
      "description": "Immutable lookup mapping referral code to registered owner UID",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "uid": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["code", "uid", "createdAt"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Verified referral redemption record (one per referred user UID)",
      "type": "object",
      "properties": {
        "referrerUid": { "type": "string" },
        "referrerCode": { "type": "string" },
        "referredUid": { "type": "string" },
        "referredEmail": { "type": "string" },
        "referredName": { "type": "string" },
        "timestamp": { "type": "number" },
        "daysAwarded": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["referrerUid", "referrerCode", "referredUid", "timestamp", "status"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminRole",
      "description": "Server-assigned administrator accounts"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/results/{resultId}": {
      "schema": "UserResult",
      "description": "User specific immutable test results subcollection"
    },
    "/users/{userId}/learning_progress/course": {
      "schema": "CourseProgress",
      "description": "User specific course unlock and progress state"
    },
    "/users/{userId}/learning_results/{resultId}": {
      "schema": "LessonAttempt",
      "description": "User immutable lesson test attempts"
    },
    "/learning_lessons/{lessonId}": {
      "schema": "CourseLesson",
      "description": "Admin managed lesson definitions"
    },
    "/user_results/{resultId}": {
      "schema": "UserResult",
      "description": "Immutable audit collection of test results"
    },
    "/leaderboard/{entryId}": {
      "schema": "LeaderboardEntry",
      "description": "Public high score board entries"
    },
    "/subscriptions/{userId}": {
      "schema": "Subscription",
      "description": "Server-managed user subscription records"
    },
    "/referral_codes/{code}": {
      "schema": "ReferralCode",
      "description": "Registered user referral code lookup registry"
    },
    "/referrals/{referredUid}": {
      "schema": "Referral",
      "description": "One-time verified referral record per referred user"
    }
  }
}
