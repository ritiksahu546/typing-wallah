rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Checks whether a server-managed /admins/{uid} document explicitly revokes
    // or deactivates admin privileges. Because Firebase custom claims remain cached
    // in client ID tokens for up to 1 hour until token refresh, checking /admins/{uid}
    // for `revoked == true` provides immediate server-side revocation enforcement.
    function isAdminRevoked() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('revoked', false) == true ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('active', true) == false
        );
    }

    function hasActiveAdminRegistryDoc() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('revoked', false) != true &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('active', true) != false;
    }

    // Trusted server-side admin verification:
    // Requires a verified email address, no revocation entry in /admins/{uid}, and either:
    // 1. Firebase Auth custom claims (request.auth.token.admin == true or role == 'admin'), OR
    // 2. A server-managed /admins/{uid} registry document where `revoked` is not true.
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        !isAdminRevoked() && (
          request.auth.token.admin == true ||
          request.auth.token.role == 'admin' ||
          hasActiveAdminRegistryDoc()
        );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNumberInRange(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUserProfile(data, uid) {
      return data.keys().hasOnly([
        'uid', 'email', 'displayName', 'photoURL', 'role', 'isPro', 'proExpiryDate',
        'targetExam', 'emailVerified', 'referralCode', 'referredBy', 'joinedDate',
        'referralCount', 'rewardDaysEarned', 'createdAt', 'lastLoginAt', 'updatedAt'
      ]) &&
      data.get('uid', uid) == uid &&
      (!('displayName' in data) || data.displayName == null || isValidString(data.displayName, 1, 120)) &&
      (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
      (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
      (!('targetExam' in data) || (data.targetExam is string && data.targetExam.size() <= 60)) &&
      (!('joinedDate' in data) || (data.joinedDate is string && data.joinedDate.size() <= 60)) &&
      (!('emailVerified' in data) || data.emailVerified is bool) &&
      (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32)) &&
      (!('referredBy' in data) || data.referredBy == null || (data.referredBy is string && data.referredBy.size() <= 32)) &&
      (!('referralCount' in data) || isNumberInRange(data.referralCount, 0, 100000)) &&
      (!('rewardDaysEarned' in data) || isNumberInRange(data.rewardDaysEarned, 0, 36500));
    }

    function isValidMetricsMap(metrics, durationSeconds) {
      return metrics is map &&
        metrics.keys().hasOnly([
          'grossWpm', 'netWpm', 'accuracy', 'totalChars', 'correctChars',
          'incorrectChars', 'errors', 'backspaceCount', 'keyDepressions',
          'elapsedSeconds', 'remainingSeconds', 'isQualified', 'kdph', 'grade'
        ]) &&
        isNumberInRange(metrics.grossWpm, 0, 300) &&
        isNumberInRange(metrics.netWpm, 0, 300) &&
        metrics.netWpm <= metrics.grossWpm &&
        isNumberInRange(metrics.accuracy, 0, 100) &&
        isNumberInRange(metrics.totalChars, 1, 50000) &&
        isNumberInRange(metrics.correctChars, 0, 50000) &&
        isNumberInRange(metrics.incorrectChars, 0, 50000) &&
        metrics.correctChars <= metrics.totalChars &&
        metrics.correctChars + metrics.incorrectChars <= metrics.totalChars + 5 &&
        isNumberInRange(metrics.errors, 0, 50000) &&
        isNumberInRange(metrics.backspaceCount, 0, 50000) &&
        isNumberInRange(metrics.keyDepressions, 0, 60000) &&
        isNumberInRange(metrics.elapsedSeconds, 1, 7200) &&
        metrics.elapsedSeconds <= durationSeconds + 1 &&
        (!('remainingSeconds' in metrics) || isNumberInRange(metrics.remainingSeconds, 0, 7200)) &&
        metrics.isQualified is bool &&
        // Mathematical consistency check: grossWpm must align with (totalChars / 5) / (elapsedSeconds / 60) within rounding tolerance (+/- 8 WPM)
        metrics.grossWpm * 5 * metrics.elapsedSeconds <= (metrics.totalChars * 60) + (8 * 5 * metrics.elapsedSeconds) &&
        metrics.totalChars * 60 <= (metrics.grossWpm * 5 * metrics.elapsedSeconds) + (8 * 5 * metrics.elapsedSeconds) &&
        (!('kdph' in metrics) || isNumberInRange(metrics.kdph, 0, 100000)) &&
        (!('grade' in metrics) || (metrics.grade is string && metrics.grade.size() <= 30));
    }

    function isValidTestResultDoc(data) {
      return data.keys().hasOnly([
        'id', 'testId', 'userId', 'userEmail', 'username', 'photoURL',
        'examId', 'examName', 'language', 'keyboardLayout',
        'durationSeconds', 'passageId', 'passageTitle',
        'metrics', 'timestamp', 'createdAt'
      ]) &&
      isValidString(data.id, 1, 120) &&
      (!('testId' in data) || data.testId == data.id) &&
      data.userId == request.auth.uid &&
      (!('userEmail' in data) || data.userEmail == null || (data.userEmail is string && data.userEmail.size() <= 200)) &&
      (!('username' in data) || data.username == null || (data.username is string && data.username.size() <= 120)) &&
      (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
      isValidString(data.examId, 1, 60) &&
      isValidString(data.examName, 1, 120) &&
      data.language in ['english', 'hindi'] &&
      (!('keyboardLayout' in data) || (data.keyboardLayout is string && data.keyboardLayout.size() <= 40)) &&
      isNumberInRange(data.durationSeconds, 10, 7200) &&
      data.passageId is string && data.passageId.size() >= 1 && data.passageId.size() <= 80 &&
      data.passageTitle is string && data.passageTitle.size() >= 1 && data.passageTitle.size() <= 160 &&
      isValidMetricsMap(data.metrics, data.durationSeconds) &&
      isNumberInRange(data.timestamp, 1000000000000, 9999999999999) &&
      'createdAt' in data &&
      data.createdAt == request.time;
    }

    // Security note: Firestore rules validate schema, user ownership, server timestamps,
    // rate-limit cooldowns, human WPM/accuracy plausibility ceilings, and cross-document
    // consistency with the user's immutable result document. They do not by themselves
    // prove that a browser did not synthesize keystrokes; backend verification (/api/results/verify)
    // provides additional validation and rate limiting.
    function isBackedByVerifiedResult(data) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.examId == data.examId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.language == data.language &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.metrics.netWpm == data.netWpm &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.metrics.netWpm == data.wpm &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.metrics.grossWpm == data.grossWpm &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.metrics.accuracy == data.accuracy &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.metrics.errors == data.mistakes &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.durationSeconds == data.durationSeconds &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.metrics.elapsedSeconds >= 10 &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/results/$(data.testId)).data.metrics.totalChars >= 25;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasOnly([
        'userId', 'username', 'name', 'photoURL', 'avatar',
        'wpm', 'netWpm', 'grossWpm', 'accuracy', 'mistakes',
        'exam', 'examId', 'language', 'durationSeconds', 'isQualified',
        'testId', 'date', 'timestamp', 'updatedAt'
      ]) &&
      data.userId == request.auth.uid &&
      isValidString(data.username, 1, 100) &&
      (!('name' in data) || isValidString(data.name, 1, 100)) &&
      (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
      (!('avatar' in data) || data.avatar == null || (data.avatar is string && data.avatar.size() <= 2048)) &&
      // Plausible human typing ceilings for public leaderboard rankings
      isNumberInRange(data.netWpm, 0, 220) &&
      isNumberInRange(data.wpm, 0, 220) &&
      data.wpm == data.netWpm &&
      isNumberInRange(data.grossWpm, 0, 240) &&
      data.netWpm <= data.grossWpm &&
      isNumberInRange(data.accuracy, 50, 100) &&
      isNumberInRange(data.mistakes, 0, 50000) &&
      isValidString(data.exam, 1, 120) &&
      isValidString(data.examId, 1, 60) &&
      data.language in ['english', 'hindi'] &&
      isNumberInRange(data.durationSeconds, 10, 7200) &&
      data.isQualified is bool &&
      isValidString(data.testId, 1, 120) &&
      (!('date' in data) || (data.date is string && data.date.size() <= 40)) &&
      (!('timestamp' in data) || data.timestamp == request.time || isNumberInRange(data.timestamp, 1000000000000, 9999999999999)) &&
      'updatedAt' in data &&
      data.updatedAt == request.time &&
      isBackedByVerifiedResult(data);
    }

    function isValidCourseProgress(data, uid) {
      return data.keys().hasOnly([
        'userId', 'currentLessonNumber', 'highestUnlockedLessonNumber',
        'completedLessonIds', 'bestWpm', 'avgWpm', 'avgAccuracy',
        'totalAttempts', 'passedAttempts', 'currentStreak', 'lastActiveDate',
        'todayWordsTyped', 'todayPracticeTimeSeconds', 'lastUpdated'
      ]) &&
      data.userId == uid &&
      isNumberInRange(data.currentLessonNumber, 1, 500) &&
      isNumberInRange(data.highestUnlockedLessonNumber, 1, 500) &&
      data.completedLessonIds is list &&
      data.completedLessonIds.size() <= 500 &&
      isNumberInRange(data.bestWpm, 0, 300) &&
      isNumberInRange(data.avgWpm, 0, 300) &&
      isNumberInRange(data.avgAccuracy, 0, 100) &&
      isNumberInRange(data.totalAttempts, 0, 1000000) &&
      isNumberInRange(data.passedAttempts, 0, 1000000) &&
      isNumberInRange(data.currentStreak, 0, 100000) &&
      data.lastActiveDate is string &&
      data.lastActiveDate.size() <= 30 &&
      isNumberInRange(data.todayWordsTyped, 0, 1000000) &&
      isNumberInRange(data.todayPracticeTimeSeconds, 0, 864000) &&
      isNumberInRange(data.lastUpdated, 0, 9999999999999);
    }

    function isValidLessonAttempt(data, uid) {
      return data.keys().hasOnly([
        'id', 'lessonId', 'lessonNumber', 'lessonName', 'userId',
        'timestamp', 'date', 'grossWpm', 'netWpm', 'accuracy',
        'errors', 'backspaces', 'durationSeconds', 'passed',
        'attemptNumber', 'createdAt'
      ]) &&
      data.userId == uid &&
      isValidString(data.id, 1, 120) &&
      isValidString(data.lessonId, 1, 80) &&
      isNumberInRange(data.lessonNumber, 1, 500) &&
      isValidString(data.lessonName, 1, 160) &&
      isNumberInRange(data.grossWpm, 0, 300) &&
      isNumberInRange(data.netWpm, 0, 300) &&
      isNumberInRange(data.accuracy, 0, 100) &&
      isNumberInRange(data.errors, 0, 50000) &&
      isNumberInRange(data.backspaces, 0, 50000) &&
      isNumberInRange(data.durationSeconds, 1, 7200) &&
      data.passed is bool &&
      isNumberInRange(data.attemptNumber, 1, 1000000) &&
      isNumberInRange(data.timestamp, 1000000000000, 9999999999999) &&
      data.date is string &&
      data.date.size() <= 30 &&
      (!('createdAt' in data) || data.createdAt == request.time);
    }

    // ===============================================================
    // Server-Managed Admin Registry (No client writes permitted)
    // ===============================================================
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow create, update, delete: if false;
    }

    // ===============================================================
    // Users & User Subcollections
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Ordinary users can create their own profile with role == 'user' and isPro == false
      allow create: if isOwner(userId) &&
                    isValidUserProfile(request.resource.data, userId) &&
                    request.resource.data.get('role', 'user') == 'user' &&
                    request.resource.data.get('isPro', false) == false &&
                    request.resource.data.get('proExpiryDate', null) == null &&
                    request.resource.data.get('referralCount', 0) == 0 &&
                    request.resource.data.get('rewardDaysEarned', 0) == 0;

      // Ordinary users can update non-privileged profile fields, but can never
      // escalate role, isPro, proExpiryDate, referralCount, rewardDaysEarned, or uid
      allow update: if (
        isOwner(userId) &&
        isValidUserProfile(request.resource.data, userId) &&
        request.resource.data.get('uid', userId) == resource.data.get('uid', userId) &&
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
        request.resource.data.get('isPro', false) == resource.data.get('isPro', false) &&
        request.resource.data.get('proExpiryDate', null) == resource.data.get('proExpiryDate', null) &&
        request.resource.data.get('referralCount', 0) == resource.data.get('referralCount', 0) &&
        request.resource.data.get('rewardDaysEarned', 0) == resource.data.get('rewardDaysEarned', 0) &&
        (
          !('createdAt' in resource.data) ||
          !('createdAt' in request.resource.data) ||
          request.resource.data.createdAt == resource.data.createdAt ||
          request.resource.data.createdAt == request.time
        )
      ) || isAdmin();

      allow delete: if isAdmin();

      // User Test Results (Immutable once created by owner)
      match /results/{resultId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
                      resultId == request.resource.data.id &&
                      isValidTestResultDoc(request.resource.data);
        allow update: if false;
        allow delete: if isAdmin();
      }

      // User Touch Typing Course Progress
      match /learning_progress/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidCourseProgress(request.resource.data, userId);
        allow delete: if isAdmin();
      }

      // User Touch Typing Lesson Attempts (Immutable once recorded)
      match /learning_results/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidLessonAttempt(request.resource.data, userId);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // Root Test Results Audit Log (Immutable once created)
    // ===============================================================
    match /user_results/{resultDocId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() &&
                    resultDocId == (request.auth.uid + '_' + request.resource.data.id) &&
                    isValidTestResultDoc(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Public Leaderboard (One best-score document per user+exam+language)
    // ===============================================================
    match /leaderboard/{entryId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
                    entryId == (request.auth.uid + '_' + request.resource.data.examId + '_' + request.resource.data.language) &&
                    isValidLeaderboardEntry(request.resource.data);

      // Only allow updating own entry when a genuinely new testId improves WPM
      // (or improves/matches accuracy at equal WPM), and enforce a 5-second server-clock cooldown
      allow update: if isAuthenticated() &&
                    entryId == (request.auth.uid + '_' + request.resource.data.examId + '_' + request.resource.data.language) &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.examId == resource.data.examId &&
                    request.resource.data.language == resource.data.language &&
                    isValidLeaderboardEntry(request.resource.data) &&
                    request.resource.data.testId != resource.data.testId &&
                    (
                      !('updatedAt' in resource.data) ||
                      !(resource.data.updatedAt is timestamp) ||
                      request.time >= resource.data.updatedAt + duration.value(5, 's')
                    ) &&
                    (
                      request.resource.data.netWpm > resource.data.get('netWpm', resource.data.get('wpm', -1)) ||
                      (
                        request.resource.data.netWpm == resource.data.get('netWpm', resource.data.get('wpm', -1)) &&
                        request.resource.data.accuracy >= resource.data.get('accuracy', 0)
                      )
                    );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Referral Code Directory (Maps public code -> owner UID)
    // ===============================================================
    match /referral_codes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    code.size() >= 6 &&
                    code.size() <= 24 &&
                    request.resource.data.keys().hasOnly(['code', 'uid', 'ownerUid', 'createdAt']) &&
                    request.resource.data.code == code &&
                    request.resource.data.get('ownerUid', request.resource.data.get('uid', '')) == request.auth.uid &&
                    request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
                    request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // Referrals (One referral claim per referred user, verified against /referral_codes)
    // ===============================================================
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource.data.referredUid == request.auth.uid ||
        resource.data.referrerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
                    (referralId == request.auth.uid || referralId == ('ref_' + request.auth.uid)) &&
                    request.resource.data.keys().hasOnly([
                      'referrerCode', 'referrerUid', 'referredUid',
                      'referredEmail', 'referredName', 'timestamp',
                      'daysAwarded', 'rewardDays', 'status', 'createdAt'
                    ]) &&
                    request.resource.data.referredUid == request.auth.uid &&
                    request.resource.data.referrerUid is string &&
                    request.resource.data.referrerUid != request.auth.uid &&
                    request.resource.data.referrerCode is string &&
                    request.resource.data.referrerCode.size() >= 6 &&
                    request.resource.data.referrerCode.size() <= 24 &&
                    (!('referredEmail' in request.resource.data) || (request.resource.data.referredEmail is string && request.resource.data.referredEmail.size() <= 200)) &&
                    (!('referredName' in request.resource.data) || (request.resource.data.referredName is string && request.resource.data.referredName.size() <= 120)) &&
                    (!('timestamp' in request.resource.data) || isNumberInRange(request.resource.data.timestamp, 1000000000000, 9999999999999)) &&
                    exists(/databases/$(database)/documents/referral_codes/$(request.resource.data.referrerCode)) &&
                    get(/databases/$(database)/documents/referral_codes/$(request.resource.data.referrerCode)).data.get('ownerUid', get(/databases/$(database)/documents/referral_codes/$(request.resource.data.referrerCode)).data.get('uid', '')) == request.resource.data.referrerUid &&
                    request.resource.data.status in ['pending', 'verified', 'recorded'] &&
                    request.resource.data.get('rewardDays', 0) == 0 &&
                    request.resource.data.get('daysAwarded', 0) == 0 &&
                    request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // Subscriptions (Server/Admin Managed Only — No self-granting)
    // ===============================================================
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // Admin CMS Collections (Public Read, Admin Write Only)
    // ===============================================================
    match /passages/{passageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /learning_lessons/{lessonId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // Default Deny All Other Paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
